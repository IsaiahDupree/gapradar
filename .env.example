# GapRadar configuration. Copy to .env.local and fill in.
# NEVER commit .env.local (it is gitignored). Placeholders only in this file.

# ── Server (set these on Vercel for the hosted connector; local for self-hosting) ──
# Supabase project backing accounts, plans, and usage counters.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret used to sign OAuth/session JWTs. Generate: openssl rand -hex 32
JWT_SECRET=change-me

# Reviewer/demo account password (email is reviewer@gapradar.demo).
DEMO_PASSWORD=change-me

# ── Stripe (paid plan billing: Builder / Pro / Studio) ──
# Leave these UNSET to run fully free / for review (every account behaves as a
# paid plan when billing is off, so all tools work). Set them to enable the gate.
# Use TEST-mode keys (sk_test_… / a test price_…) until launch.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_PRO=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Live store data (DemandRadar backend) ──
# The upstream store-intelligence API GapRadar queries for real rankings,
# reviews, pricing, and availability. Leave UNSET to run in demo mode (the
# reviewer demo account serves sample apps + opportunities so every tool works).
DEMANDRADAR_URL=https://YOUR-DEMANDRADAR-HOST
DEMANDRADAR_API_KEY=your-demandradar-api-key

# Absolute base used to build Stripe success/cancel + /upgrade URLs.
PUBLIC_BASE_URL=https://gapradar.vercel.app

# ── Kit / e2e (kit/register-connector.mjs) ──
NB_SERVER=https://gapradar.vercel.app
# The GapRadar account the connector signs in as (the demo account).
NB_EMAIL=reviewer@gapradar.demo
NB_PASSWORD=your-gapradar-demo-password
